# Copy to /etc/easyrental/production.env on the OCI VM. Never commit real secrets.

NODE_ENV=production
HOSTED=1
PORT=43123

# Required (≥16 chars)
DESKULPT_SECRET_KEY=

DESKULPT_DB_PATH=/data/deskulpt.sqlite
DESKULPT_DEMO_SWITCHER=0

# Compliance mirrors — keep OFF until Admin console (ER-47) flips toggles
EASYRENTAL_FLAG_IN_PAY_PLANE=0
EASYRENTAL_FLAG_CA_PAY_PLANE=0

# Billing / OTP / KYC — demo / test until MoR live
BILLING_PROVIDER=demo
BILLING_INTL_PROVIDER=demo
OTP_SMS_PROVIDER=demo
KYC_PROVIDER=demo
# DODO_LIVE=0
# PAYPAL_LIVE=0
# OTP_LIVE=0
# KYC_LIVE=0
# ESIGN_LIVE=0

# Mail — only after MX/SPF/DKIM exist on easyrental.space
# OTP_EMAIL_PROVIDER=email
# RESEND_API_KEY=
# EMAIL_FROM=noreply@easyrental.space
