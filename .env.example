# Easy Rental — environment checklist (copy to .env.local for local override)
# On Railway: set these as service variables. Never commit real secrets.

# Required in production (min 16 chars). Signs session cookies + encrypts shop secrets.
DESKULPT_SECRET_KEY=

# Optional SQLite path. Default: ./data/deskulpt.sqlite
# On OCI / Railway attach a volume and point this at the mount (e.g. /data/deskulpt.sqlite).
DESKULPT_DB_PATH=

# Preferred public host: Cloudflare Free (EasyRental account) + Canada origin.
# See docs/hosting-cloudflare-oci.md. PARK India: in-pay reserved no-build; ca-pay stub OFF.
# EASYRENTAL_FLAG_CA_PAY=0
# EASYRENTAL_FLAG_IN_PAY=0
# HOSTED=1

# Legacy flag — public header demo switcher is retired. Impersonation is L0/L1 sticky bar only.
# Leave unset/0 in production with real data.
DESKULPT_DEMO_SWITCHER=0

# Local/e2e seed password for L0 admindeskulpt@gmail.com (and L1 staff@deskulpt.example).
# Hash is baked into lib/seed-demo.ts; change both together if you rotate.
EASYRENTAL_L0_PASSWORD=DeskulptL0!admin

# Optional: Google Cloud Translation for CMS language add
# GOOGLE_CLOUD_TRANSLATION_API_KEY=

# Ask Easy lease eSign — India Digio / eMudhra (approve-before-send unchanged)
# ESIGN_PROVIDER=demo|digio|emudhra|docusign  (default: demo)
# ESIGN_PROVIDER=demo
# ESIGN_CALLBACK_URL=https://your-host/api/esign/callback
# ESIGN_LIVE=0
# Digio (Aadhaar eSign shaped dry-run when keys set; live HTTP gated by ESIGN_LIVE)
# DIGIO_CLIENT_ID=
# DIGIO_CLIENT_SECRET=
# DIGIO_BASE_URL=https://api.digio.in
# eMudhra ASP (OTP eSign shaped dry-run when keys set; needs ESIGN_CALLBACK_URL)
# EMUDHRA_ASP_ID=
# EMUDHRA_API_KEY=
# EMUDHRA_BASE_URL=https://api.emudhra.com

# --- Platform billing (test mode; no live charges in this build) ---
# Live demo / no vendor keys: demo. Production MoR: dodo (preferred) | stripe
BILLING_PROVIDER=demo
# Outside India (NRI/intl): paypal by default — PayPal does not process domestic IN.
# For keyless demos keep intl on demo too:
BILLING_INTL_PROVIDER=demo
# BILLING_FORCE_PROVIDER=   # optional ops override (skips country routing)
# DODO_API_KEY=
# DODO_WEBHOOK_SECRET=
# DODO_LIVE=0
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# BILLING_ALLOW_DEMO_WEBHOOK=0
# PayPal Subscriptions (sandbox only — Deskulpt Inc Canadian business account)
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# PAYPAL_WEBHOOK_SECRET=
# PAYPAL_CHECKOUT_CURRENCY=CAD
# PAYPAL_INR_PER_CAD=61.5
# PAYPAL_INR_PER_USD=83
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# PAYPAL_LIVE=0

# --- OTP delivery (codes never returned when NODE_ENV=production) ---
# demo | msg91 | twilio
OTP_SMS_PROVIDER=demo
# MSG91_AUTH_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# OTP_EMAIL_PROVIDER=email
# RESEND_API_KEY=
# OTP_LIVE=0

# --- KYC redirect (demo | idfy | signzy | hyperverge) ---
KYC_PROVIDER=demo
# IDFY_WEBHOOK_SECRET=
# SIGNZY_WEBHOOK_SECRET=
# HYPERVERGE_WEBHOOK_SECRET=
# KYC_LIVE=0

# --- MCP auth (fail-closed in production / HOSTED) ---
# demo:<userId> tokens work in local OSS only. Production prefers tenant-bound
# er_pat_* grants (POST /api/mcp/oauth/token) or EASYRENTAL_MCP_TOKENS map.
# Dual opt-in for demo tokens: EASYRENTAL_MCP_ALLOW_DEMO=1 AND ALLOW_DEMO_AUTH=1.
# EASYRENTAL_MCP_ALLOW_DEMO=0
# EASYRENTAL_MCP_TOKENS={"my-pat":"u_nadia"}
# EASYRENTAL_MCP_DEFAULT_TOKEN=
# EASYRENTAL_MCP_ALLOW_BARE_IDS=0
# EASYRENTAL_MCP_TOKEN_TTL_SECONDS=3600
# Auth-code + PKCE (S256) — OFF until host cert; session-exchange PAT remains default.
# EASYRENTAL_MCP_OAUTH_PKCE=0
# Edge block /api/mcp in production/HOSTED until Eng clears (proxy + route).
# EASYRENTAL_MCP_EDGE_ALLOW=0
# Proposal dual-control TTL hours (never-auto); Aloke Nov10 refund CAD500 / CAD2k/day locked in code.
# EASYRENTAL_PROPOSAL_TTL_HOURS=24

# --- D09 dual-control ---
# Never-auto proposal TTL (hours). CAD thresholds are Finance policy — not env-weakened.
# EASYRENTAL_PROPOSAL_TTL_HOURS=24

# --- Ask Easy live model (fail-closed) ---
# Key alone does NOT enable outbound calls. Set ASK_EASY_LIVE_MODEL=1 explicitly.
# ASK_EASY_LIVE_MODEL=0
# ASK_EASY_MODEL_API_KEY=
# ASK_EASY_MODEL_URL=
# ASK_EASY_MODEL_NAME=

# --- Compliance host rails (ER-48) — reserved OFF until Admin console + Legal/Finance ---
# DNS for in-pay / ca-pay must not be created while these are 0. Payments OFF; India OFF.
EASYRENTAL_FLAG_IN_PAY=0
EASYRENTAL_FLAG_CA_PAY=0

# --- Live money rails (keep OFF for synthetic demo) ---
# DODO_LIVE=0
# PAYPAL_LIVE=0
# STRIPE live keys unset
# ESIGN_LIVE=0
# OTP_LIVE=0
# KYC_LIVE=0

# Node
NODE_ENV=production
PORT=43123
